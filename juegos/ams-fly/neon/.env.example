PORT=3000
DATABASE_URL=postgresql://...
NEON_AUTH_JWKS_URL=https://<endpoint-neon-auth>/neondb/auth/.well-known/jwks.json
CORS_ORIGIN=https://avilamorasoluciones.com

# SMS / OTP de identidad del piloto (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Set true when the API is behind a trusted reverse proxy such as Coolify/Traefik.
TRUST_PROXY=true
